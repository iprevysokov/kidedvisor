<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".club.presentation.ui.fragment.FeedbacksFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_feedbacks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:buttonGravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/reviews" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_feedbacks">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_in_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_name_club"
                style="@style/RegularText20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Олимпийский" />

            <TextView
                android:id="@+id/tv_address_club"
                style="@style/RegularText12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/dark_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name_club"
                tools:text="Олимпийский проспект, 16 стр1, Москва" />

            <View
                android:id="@+id/view"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/light_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_address_club" />

            <TextView
                android:id="@+id/tv_average_rating"
                style="@style/Average_ranting_36"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/view"
                app:layout_constraintTop_toBottomOf="@+id/view"
                tools:text="4,9" />

            <TextView
                android:id="@+id/common_average"
                style="@style/RegularText12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="из 5"
                android:textColor="@color/rating_gray"
                app:layout_constraintEnd_toEndOf="@+id/tv_average_rating"
                app:layout_constraintStart_toStartOf="@+id/tv_average_rating"
                app:layout_constraintTop_toBottomOf="@+id/tv_average_rating" />

            <ImageView
                android:id="@+id/five_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/five_stars"
                app:layout_constraintStart_toEndOf="@+id/tv_average_rating"
                app:layout_constraintTop_toTopOf="@+id/tv_average_rating" />

            <ImageView
                android:id="@+id/four_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/four_stars"
                app:layout_constraintEnd_toEndOf="@+id/five_stars"
                app:layout_constraintTop_toBottomOf="@+id/five_stars" />

            <ImageView
                android:id="@+id/three_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/three_stars"
                app:layout_constraintEnd_toEndOf="@+id/four_stars"
                app:layout_constraintTop_toBottomOf="@+id/four_stars" />

            <ImageView
                android:id="@+id/two_stars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/two_stars"
                app:layout_constraintEnd_toEndOf="@+id/three_stars"
                app:layout_constraintTop_toBottomOf="@+id/three_stars" />

            <ImageView
                android:id="@+id/one_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/one_star"
                app:layout_constraintEnd_toEndOf="@+id/two_stars"
                app:layout_constraintTop_toBottomOf="@+id/two_stars" />

            <ProgressBar
                android:id="@+id/progressBar_five_stars"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:max="100"
                android:progressDrawable="@drawable/rounder_progress_bar"
                app:layout_constraintBottom_toBottomOf="@+id/five_stars"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/five_stars"
                app:layout_constraintTop_toTopOf="@+id/five_stars" />

            <ProgressBar
                android:id="@+id/progressBar_four_stars"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:max="100"
                android:progressDrawable="@drawable/rounder_progress_bar"
                app:layout_constraintBottom_toBottomOf="@+id/four_stars"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/four_stars"
                app:layout_constraintTop_toTopOf="@+id/four_stars" />

            <ProgressBar
                android:id="@+id/progressBar_three_stars"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:max="100"
                android:progressDrawable="@drawable/rounder_progress_bar"
                app:layout_constraintBottom_toBottomOf="@+id/three_stars"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/three_stars"
                app:layout_constraintTop_toTopOf="@+id/three_stars" />

            <ProgressBar
                android:id="@+id/progressBar_two_stars"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:max="100"
                android:progressDrawable="@drawable/rounder_progress_bar"
                app:layout_constraintBottom_toBottomOf="@+id/two_stars"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/two_stars"
                app:layout_constraintTop_toTopOf="@+id/two_stars" />

            <ProgressBar
                android:id="@+id/progressBar_one_star"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:max="100"
                android:progressDrawable="@drawable/rounder_progress_bar"
                app:layout_constraintBottom_toBottomOf="@+id/one_star"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/one_star"
                app:layout_constraintTop_toTopOf="@+id/one_star" />

            <View
                android:id="@+id/view_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@color/light_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/common_average" />

            <TextView
                android:id="@+id/assessment_by_touch"
                style="@style/RegularText12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:text="Оценка касанием:"
                android:textColor="@color/rating_touch_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_2" />

            <me.zhanghai.android.materialratingbar.MaterialRatingBar
                style="@style/Widget.MaterialRatingBar.RatingBar"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:numStars="5"
                android:rating="4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/assessment_by_touch"
                app:layout_constraintTop_toBottomOf="@+id/view_2"
                app:mrb_progressTint="@color/dark_blue" />

            <Button
                android:id="@+id/btn_write_feedback"
                style="@style/FillButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:text="Написать отзыв"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/assessment_by_touch" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_photo_feedback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="@dimen/gap_16"
                android:layout_marginEnd="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_write_feedback"
                tools:itemCount="4"
                tools:listitem="@layout/item_photo_club"
                tools:orientation="horizontal" />

            <TextView
                android:id="@+id/watch_all"
                style="@style/RegularText14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_16"
                android:layout_marginTop="@dimen/gap_8"
                android:text="@string/watch_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_photo_feedback" />

            <TextView
                android:id="@+id/textView"
                style="@style/MediumText16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_16"
                android:layout_marginTop="@dimen/gap_16"
                android:text="@string/reviews"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/watch_all" />

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_16"
                android:layout_marginTop="@dimen/gap_8"
                android:layout_marginEnd="@dimen/gap_16"
                android:background="@drawable/rectangle_for_big_edittext"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/gap_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView">

                <ImageView
                    android:id="@+id/filter_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/gap_12"
                    android:src="@drawable/filter_feedback" />

                <TextView
                    android:id="@+id/description_filter"
                    style="@style/RegularText16"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/gap_12"
                    android:text="Сначала новые"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:id="@+id/apply_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_forward_feedback" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/gap_16"
                android:layout_marginTop="@dimen/gap_16"
                android:layout_marginEnd="@dimen/gap_16"
                android:layout_marginBottom="@dimen/gap_12"
                android:nestedScrollingEnabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout"
                tools:itemCount="5"
                tools:listitem="@layout/feedback_item" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        app:layout_anchor="@id/toolbar_feedbacks"
        app:layout_anchorGravity="center" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_sheet_feedbacks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet"
        android:clickable="true"
        android:paddingHorizontal="@dimen/gap_16"
        app:behavior_hideable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/show_first"
            style="@style/MediumText20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/show_first"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:background="@drawable/background_btst_feedback_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/show_first">

            <TextView
                android:id="@+id/textView2"
                style="@style/RegularText14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="71dp"
                android:text="Сначала новые"
                app:layout_constraintEnd_toStartOf="@+id/radioGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <RadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </RadioGroup>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="overlay, bottom_sheet_feedbacks" />

</androidx.constraintlayout.widget.ConstraintLayout>