<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:id="@+id/image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_16"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/club_image"
            android:layout_width="120dp"
            android:layout_height="82dp"
            tools:src="@drawable/banner_main" />

        <TextView
            android:id="@+id/rating_badge"
            style="@style/BadgeRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="5dp"
            tools:text="3.5"
            android:layout_gravity="end|top" />
    </androidx.cardview.widget.CardView>

    <RatingBar
        android:id="@+id/ratingBar"
        style="@style/SmallStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_16"
        app:layout_constraintStart_toEndOf="@id/image_container"
        app:layout_constraintTop_toTopOf="@id/image_container"
        tools:rating="3.7" />

    <TextView
        android:id="@+id/club_title"
        style="@style/Title14"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/ratingBar"
        app:layout_constraintTop_toBottomOf="@id/ratingBar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Дворец спорта" />

    <TextView
        android:id="@+id/club_address"
        style="@style/RegularText12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/ratingBar"
        app:layout_constraintTop_toBottomOf="@id/club_title"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Металлистов, д.1" />

    <ImageView
        android:id="@+id/type_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/ratingBar"
        app:layout_constraintTop_toBottomOf="@id/club_address"
        tools:src="@drawable/ic_sports_soccer_24" />

    <TextView
        android:id="@+id/club_type"
        style="@style/RegularText12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_2"
        app:layout_constraintBottom_toBottomOf="@id/type_icon"
        app:layout_constraintStart_toEndOf="@id/type_icon"
        app:layout_constraintTop_toTopOf="@id/type_icon"
        tools:text="Спорт, Футбол" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/gap_16"
        android:background="@color/light_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_container" />

</androidx.constraintlayout.widget.ConstraintLayout>